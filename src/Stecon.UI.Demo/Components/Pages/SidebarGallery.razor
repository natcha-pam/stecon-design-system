@page "/sidebar-gallery"
@inject IThemeService ThemeService
@implements IDisposable

@{
    RenderFragment userContent = @<text>
        <SteconAvatar InitialsText="JD" AltText="Jane Doe" />
        <span class="stecon-gallery-user-name">Jane Doe</span>
    </text>;
}

<PageTitle>Sidebar Gallery</PageTitle>

<h1>Sidebar Gallery</h1>
<p>
    Verify <code>SteconSidebar</code> across variants, states, and themes. The
    switch to the mobile drawer presentation happens at the real browser
    viewport width (&lt; 768px), not inside this page's controls - resize the
    browser window to <strong>375px</strong>, <strong>768px</strong>, and
    <strong>1440px</strong> to complete responsive verification.
</p>

<div class="stecon-gallery-controls">
    <div class="stecon-gallery-field">
        <label class="stecon-gallery-field__label" for="gallery-variant">Variant</label>
        <SteconSelect TValue="SidebarVariant" @bind-Value="_variant" AdditionalAttributes="@(new Dictionary<string, object> { ["id"] = "gallery-variant" })">
            @foreach (var variant in Enum.GetValues<SidebarVariant>())
            {
                <option value="@variant">@variant</option>
            }
        </SteconSelect>
    </div>

    <div class="stecon-gallery-field">
        <label class="stecon-gallery-field__label" for="gallery-dataset">Dataset</label>
        <SteconSelect TValue="string" @bind-Value="_dataset" AdditionalAttributes="@(new Dictionary<string, object> { ["id"] = "gallery-dataset" })">
            <option value="flat">Flat</option>
            <option value="grouped">Grouped</option>
            <option value="nested">Nested</option>
        </SteconSelect>
    </div>

    <div class="stecon-gallery-field">
        <span class="stecon-gallery-field__label">States</span>
        <div class="stecon-gallery-toggles">
            <SteconCheckbox @bind-Value="_collapsed">Collapsed</SteconCheckbox>
            <SteconCheckbox @bind-Value="_showBrand">Brand</SteconCheckbox>
            <SteconCheckbox @bind-Value="_showUser">User area</SteconCheckbox>
        </div>
    </div>

    <div class="stecon-gallery-field">
        <span class="stecon-gallery-field__label">Actions</span>
        <div class="stecon-gallery-actions">
            <SteconButton Variant="ButtonVariant.Secondary" OnClick="ToggleTheme">
                Theme: @ThemeService.Current
            </SteconButton>
            <SteconButton Variant="ButtonVariant.Primary" OnClick="OpenMobileDrawer">
                Open mobile drawer
            </SteconButton>
        </div>
    </div>
</div>

<div class="stecon-gallery-preview">
    <SteconSidebar Variant="_variant"
                   Items="CurrentItems"
                   @bind-Collapsed="_collapsed"
                   BrandLogo="@(_showBrand ? "_content/Stecon.UI/brand/stecon-logo.jpg" : null)"
                   BrandTitle="@(_showBrand ? "STECON" : null)"
                   UserContent="@(_showUser ? userContent : null)"
                   @bind-IsMobileOpen="_mobileOpen" />

    <div class="stecon-gallery-preview__content">
        <div class="stecon-gallery-preview__header">
            <span class="stecon-gallery-preview__heading">Main content</span>
            <span class="stecon-gallery-preview__meta">@_variant &middot; @(_collapsed ? "Collapsed" : "Expanded")</span>
        </div>
        <p>This area represents the application's main content region next to the sidebar.</p>
        <div class="stecon-gallery-placeholder"></div>
        <div class="stecon-gallery-placeholder"></div>
    </div>
</div>

@code {
    private SidebarVariant _variant = SidebarVariant.Workflow;
    private string _dataset = "flat";
    private bool _collapsed;
    private bool _showBrand = true;
    private bool _showUser = true;
    private bool _mobileOpen;

    private IReadOnlyList<SteconNavItem> CurrentItems => _dataset switch
    {
        "grouped" => DemoNavItems.Grouped,
        "nested" => DemoNavItems.Nested,
        _ => DemoNavItems.Flat,
    };

    private void ToggleTheme() =>
        ThemeService.SetTheme(ThemeService.Current == ThemeMode.Light ? ThemeMode.Dark : ThemeMode.Light);

    private void OpenMobileDrawer() => _mobileOpen = true;

    protected override void OnInitialized()
    {
        ThemeService.ThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged(ThemeMode mode) => InvokeAsync(StateHasChanged);

    public void Dispose() => ThemeService.ThemeChanged -= OnThemeChanged;
}
