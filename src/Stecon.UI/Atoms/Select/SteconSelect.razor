@namespace Stecon.UI
@typeparam TValue

<select class="@CssClass"
        disabled="@Disabled"
        aria-invalid="@(IsInvalid ? "true" : null)"
        aria-describedby="@DescribedBy"
        value="@FormatValueAsString(Value)"
        @attributes="SplatAttributes"
        @onchange="HandleChange">
    @ChildContent
</select>

@code {
    [Parameter]
    public TValue Value { get; set; } = default!;

    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<TValue>>? ValueExpression { get; set; }

    /// <summary>Consumer authors &lt;option&gt; elements directly (v1 - no Items/reflection-based generation).</summary>
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool IsInvalid { get; set; }

    [Parameter]
    public string? DescribedBy { get; set; }

    [Parameter]
    public ControlSize Size { get; set; } = ControlSize.Md;

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string SizeClass => Size.ToString().ToLowerInvariant();

    private string CssClass => CssClassMerge.Combine($"stecon-select stecon-select--{SizeClass}", AdditionalAttributes);

    private IReadOnlyDictionary<string, object>? SplatAttributes => CssClassMerge.AttributesWithoutClass(AdditionalAttributes);

    private static string? FormatValueAsString(TValue value) =>
        BindConverter.FormatValue(value, CultureInfo.CurrentCulture)?.ToString();

    private async Task HandleChange(ChangeEventArgs e)
    {
        var stringValue = e.Value?.ToString();
        if (BindConverter.TryConvertTo<TValue>(stringValue, CultureInfo.CurrentCulture, out var result))
        {
            await ValueChanged.InvokeAsync(result);
        }
    }
}
