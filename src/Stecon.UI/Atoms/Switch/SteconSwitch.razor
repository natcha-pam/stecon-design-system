@namespace Stecon.UI

<label class="stecon-switch @(Disabled ? "stecon-switch--disabled" : null)">
    <input type="checkbox"
           role="switch"
           class="@CssClass"
           checked="@Value"
           disabled="@Disabled"
           aria-describedby="@DescribedBy"
           @attributes="SplatAttributes"
           @onchange="HandleChange" />
    <span class="stecon-switch__track" aria-hidden="true"></span>
    @if (ChildContent is not null)
    {
        <span class="stecon-switch__label">@ChildContent</span>
    }
</label>

@code {
    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<bool>>? ValueExpression { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? DescribedBy { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => CssClassMerge.Combine("stecon-switch__input", AdditionalAttributes);

    private IReadOnlyDictionary<string, object>? SplatAttributes => CssClassMerge.AttributesWithoutClass(AdditionalAttributes);

    private Task HandleChange(ChangeEventArgs e) => ValueChanged.InvokeAsync((bool)(e.Value ?? false));
}
