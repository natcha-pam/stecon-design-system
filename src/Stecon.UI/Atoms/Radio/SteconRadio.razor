@namespace Stecon.UI
@typeparam TValue

<label class="stecon-radio @(IsDisabled ? "stecon-radio--disabled" : null)">
    <input type="radio"
           class="@CssClass"
           name="@GroupName"
           checked="@IsChecked"
           disabled="@IsDisabled"
           @attributes="SplatAttributes"
           @onchange="HandleChange" />
    @if (ChildContent is not null)
    {
        <span class="stecon-radio__label">@ChildContent</span>
    }
</label>

@code {
    [CascadingParameter]
    private RadioGroupContext<TValue>? GroupContext { get; set; }

    [Parameter, EditorRequired]
    public TValue Value { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Advanced/standalone usage outside a <see cref="SteconRadioGroup{TValue}"/> - normally left unset.</summary>
    [Parameter]
    public string? Name { get; set; }

    [Parameter]
    public bool? Checked { get; set; }

    [Parameter]
    public EventCallback<TValue> OnSelected { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string GroupName => Name ?? GroupContext?.Name ?? "stecon-radio";

    private string CssClass => CssClassMerge.Combine("stecon-radio__input", AdditionalAttributes);

    private IReadOnlyDictionary<string, object>? SplatAttributes => CssClassMerge.AttributesWithoutClass(AdditionalAttributes);

    private bool IsChecked => Checked ?? (GroupContext is not null && EqualityComparer<TValue>.Default.Equals(GroupContext.SelectedValue, Value));

    private bool IsDisabled => Disabled || (GroupContext?.Disabled ?? false);

    // A native radio's onchange only ever fires when it becomes the checked one (browsers never
    // fire onchange for the radio that becomes unchecked), so being invoked at all already means
    // "select this value" - no need to inspect e.Value. Radios (unlike checkboxes) do not report
    // a boolean here; casting e.Value to bool throws in a real browser (radio.value defaults to
    // the string "on"), a defect only ever masked by tests passing a real bool via bUnit's
    // synthetic Change(true) helper. Found via live browser QA during M3.
    private async Task HandleChange(ChangeEventArgs e)
    {
        if (GroupContext is not null)
        {
            await GroupContext.SelectAsync(Value);
        }
        else
        {
            await OnSelected.InvokeAsync(Value);
        }
    }
}
