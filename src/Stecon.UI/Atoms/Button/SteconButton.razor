@namespace Stecon.UI

<button type="@TypeAttribute"
        class="@CssClass"
        disabled="@(Disabled || Loading)"
        aria-busy="@(Loading ? "true" : null)"
        @onclick="HandleClick"
        @attributes="SplatAttributes">
    @if (IconStart is not null)
    {
        <span class="stecon-button__icon" aria-hidden="true">@IconStart</span>
    }
    @if (Loading)
    {
        <span class="stecon-button__spinner" aria-hidden="true"></span>
    }
    <span class="stecon-button__label">@ChildContent</span>
    @if (IconEnd is not null)
    {
        <span class="stecon-button__icon" aria-hidden="true">@IconEnd</span>
    }
</button>

@code {
    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;

    [Parameter]
    public ControlSize Size { get; set; } = ControlSize.Md;

    [Parameter]
    public ButtonType Type { get; set; } = ButtonType.Button;

    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Shows a spinner and blocks interaction. The label stays visible (no width jump).</summary>
    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public RenderFragment? IconStart { get; set; }

    [Parameter]
    public RenderFragment? IconEnd { get; set; }

    [Parameter]
    public bool FullWidth { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string VariantClass => Variant.ToString().ToLowerInvariant();
    private string SizeClass => Size.ToString().ToLowerInvariant();

    private string CssClass => CssClassMerge.Combine(
        $"stecon-button stecon-button--{VariantClass} stecon-button--{SizeClass}{(FullWidth ? " stecon-button--full-width" : "")}",
        AdditionalAttributes);

    private IReadOnlyDictionary<string, object>? SplatAttributes => CssClassMerge.AttributesWithoutClass(AdditionalAttributes);

    private string TypeAttribute => Type switch
    {
        ButtonType.Submit => "submit",
        ButtonType.Reset => "reset",
        _ => "button",
    };

    private async Task HandleClick(MouseEventArgs e)
    {
        if (Disabled || Loading)
        {
            return;
        }

        await OnClick.InvokeAsync(e);
    }
}
