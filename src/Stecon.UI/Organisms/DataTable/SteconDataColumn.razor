@namespace Stecon.UI
@typeparam TItem
@implements IDisposable

@* Renders nothing itself - purely registers its configuration with the parent
   SteconDataTable, which owns all actual <table> markup. *@

@code {
    [CascadingParameter]
    private SteconDataTable<TItem>? Table { get; set; }

    /// <summary>Required, explicit, stable identity - never derived from <see cref="Title"/>/reflection. Foundation for future visibility/ordering/personalization.</summary>
    [Parameter, EditorRequired]
    public string Key { get; set; } = default!;

    [Parameter]
    public string? Title { get; set; }

    /// <summary>Overrides <see cref="Title"/> when supplied.</summary>
    [Parameter]
    public RenderFragment? HeaderTemplate { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment<TItem>? CellTemplate { get; set; }

    /// <summary>The table never sorts <see cref="SteconDataTable{TItem}.Items"/> itself - this only renders a sortable header button and reports the requested state via <see cref="SteconDataTable{TItem}.SortChanged"/>.</summary>
    [Parameter]
    public bool Sortable { get; set; }

    [Parameter]
    public string? Width { get; set; }

    [Parameter]
    public string? MinWidth { get; set; }

    [Parameter]
    public string? MaxWidth { get; set; }

    [Parameter]
    public DataTableColumnAlign Align { get; set; } = DataTableColumnAlign.Start;

    [Parameter]
    public bool Visible { get; set; } = true;

    [Parameter]
    public string? HeaderClass { get; set; }

    [Parameter]
    public string? CellClass { get; set; }

    // Snapshot of the parameters that affect the parent table's own markup (excludes
    // HeaderTemplate/CellTemplate, whose delegate identity is not a meaningful change signal
    // and whose content the table already re-invokes fresh on every one of its own renders).
    private (bool Visible, string? Title, bool Sortable, string? Width, string? MinWidth, string? MaxWidth, DataTableColumnAlign Align, string? HeaderClass, string? CellClass) _lastNotifiedState;
    private bool _isRegistered;

    private (bool, string?, bool, string?, string?, string?, DataTableColumnAlign, string?, string?) CurrentState =>
        (Visible, Title, Sortable, Width, MinWidth, MaxWidth, Align, HeaderClass, CellClass);

    protected override void OnInitialized()
    {
        if (string.IsNullOrWhiteSpace(Key))
        {
            throw new InvalidOperationException($"{nameof(SteconDataColumn<TItem>)} requires an explicit non-empty {nameof(Key)}.");
        }

        _lastNotifiedState = CurrentState;
        _isRegistered = true;
        Table?.AddColumn(this);
    }

    // Blazor applies a child's new parameter values to this instance before this runs, but the
    // parent's own render output (built in the same pass that produced those new parameter
    // frames) was already computed from the *previous* values. Without this, a consumer toggling
    // e.g. Visible would only take effect one unrelated table re-render later - or never, if none
    // occurs. Only notify the table when something it actually renders from changed, so this
    // can never loop: an unrelated render of this column reports no change and stops here.
    protected override void OnParametersSet()
    {
        if (!_isRegistered)
        {
            return;
        }

        var current = CurrentState;
        if (!current.Equals(_lastNotifiedState))
        {
            _lastNotifiedState = current;
            Table?.NotifyColumnChanged();
        }
    }

    public void Dispose() => Table?.RemoveColumn(this);
}
